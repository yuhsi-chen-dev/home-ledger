# ⚠️ 改建過渡期：Google 登入（階段 1）還沒實作完，現在跑起來仍然需要
# APP_PASSWORD。階段 1 的 PR 進去之後把下面這一行刪掉。
APP_PASSWORD=

# 地端（docker 的 Postgres，見 README「地端跑起來」）：
DATABASE_URL=postgres://postgres:dev@localhost:55432/home_ledger

# 線上（Neon）：要用 -pooler 那條連線字串。
# DATABASE_URL=postgres://...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google OAuth（Cloud Console 建一個 Web application 型別的 OAuth Client ID）。
# redirect URI 必須完全字串相符，地端要填 http://localhost:3000/auth/google/callback
# ⚠️ consent screen 記得 Publish 成 In production，否則只有 test users 能登入。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 簽 session cookie 的 HMAC 金鑰：openssl rand -base64 32
# 地端與線上各一把，不要共用。換掉它等於把所有人登出。
SESSION_SECRET=

# OAuth 的 redirect_uri 與邀請連結要用的絕對網址。線上填正式網域。
APP_URL=http://localhost:3000
